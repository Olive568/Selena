{"nodes": [{"id": "finance_ai_changes_documentation", "label": "Pre-Launch Audit Fixes Documentation", "file_type": "document", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "finance_ai_changes_documentation_test_suite", "label": "Vitest Test Suite for lib/finance.ts", "file_type": "concept", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Financial math functions had zero test coverage, making every refactor or deploy blind; a Vitest suite was added to verify them."}, {"id": "finance_ai_changes_documentation_create_transfer_rpc", "label": "Atomic Transfer RPC (create_transfer)", "file_type": "rationale", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two separate INSERTs could leave a transfer record with no matching transaction; a single security-definer plpgsql transaction makes both insert atomically."}, {"id": "finance_ai_changes_documentation_idempotency", "label": "Write Idempotency via idempotency_key", "file_type": "rationale", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Network retries and double-clicks could create duplicate rows; a UNIQUE idempotency_key with ON CONFLICT DO NOTHING makes writes idempotent."}, {"id": "finance_ai_changes_documentation_account_id_fk", "label": "account_id FK for Balance Computation", "file_type": "concept", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "payment_method string matching broke balances when account names changed; storing the account UUID makes balance calculations immune to renames."}, {"id": "finance_ai_changes_documentation_server_validation", "label": "Server-Side Money Validation (CHECK Constraints + RPCs)", "file_type": "rationale", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser-to-Supabase writes via the anon key had no validation; DB CHECK constraints plus validated security-definer RPCs enforce amount/type rules server-side."}, {"id": "finance_ai_changes_documentation_integer_cents", "label": "Integer Cents Money Storage", "file_type": "rationale", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IEEE-754 doubles accumulate rounding errors (0.1+0.2 != 0.3); storing bigint cents and converting at read/write boundaries keeps money exact."}, {"id": "finance_ai_changes_documentation_session_expiry", "label": "Session Expiry Handling (redirectIfAuthError)", "file_type": "rationale", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invalidated sessions silently failed mutations; an onAuthStateChanged listener plus a redirectIfAuthError helper redirect to /login."}, {"id": "finance_ai_changes_documentation_sanitize_error", "label": "Sanitized Supabase Error Messages", "file_type": "rationale", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw Supabase errors leaked table/constraint/auth internals; a central sanitizeError maps them to user-safe generic messages."}, {"id": "finance_ai_changes_documentation_soft_delete", "label": "Soft Delete with Undo (deleted_at)", "file_type": "rationale", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard deletes were unrecoverable; a deleted_at timestamp, a restore_transaction RPC, and Undo banners enable in-session recovery."}, {"id": "finance_ai_changes_documentation_rate_limiter", "label": "/api/chat In-Memory Rate Limiter", "file_type": "rationale", "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlimited /api/chat was abusable; a 20 req/min/IP in-memory window (stateless, adequate for single-instance deployment) addresses it."}], "edges": [{"source": "finance_ai_changes_documentation", "target": "finance_ai_changes_documentation_test_suite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "weight": 1.0}, {"source": "finance_ai_changes_documentation", "target": "finance_ai_changes_documentation_create_transfer_rpc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "weight": 1.0}, {"source": "finance_ai_changes_documentation", "target": "finance_ai_changes_documentation_idempotency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "weight": 1.0}, {"source": "finance_ai_changes_documentation", "target": "finance_ai_changes_documentation_account_id_fk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finance-ai/CHANGES_DOCUMENTATION.txt", "source_location": null, "weight": 1.0}, {"source": "finance_ai_changes_documentation", "target": "finance_ai_changes_documentation_server_v